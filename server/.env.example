# Runtime
NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (credentialed requests cannot use a wildcard).
# Optional in development — defaults to the Vite dev server below.
# REQUIRED when NODE_ENV=production, e.g. https://poultry.example.com
CLIENT_ORIGIN=http://localhost:5173

# Database (must match the Postgres started via docker compose at the repo root)
DATABASE_URL=postgresql://poultry_admin:changeme@localhost:5432/poultry_management?schema=public

# Auth — JWT signing secret. MUST be at least 32 characters.
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# OTP delivery via HTTPSMS (required at boot; used by the phone-login flow)
HTTPSMS_API_KEY=<your-httpsms-api-key>
HTTPSMS_FROM_PHONE=<your-httpsms-sender-phone>

# System Admin — the single global administrator. NOT a seeded user row: these
# live only here so the admin can never be listed/edited/deleted as a company
# employee and never has a passwordHash in the database. Set all three together
# to enable it, or leave all three unset to disable. Never commit real values.
SYSTEM_ADMIN_EMAIL=<system-admin-email>
SYSTEM_ADMIN_PHONE=<system-admin-phone-number>
SYSTEM_ADMIN_PASSWORD=<choose-a-strong-password-min-12-chars>

# Seed — the bootstrap DGM account created by `npm run seed`. Every other seeded
# demo login (company admins, farm DGMs, accountants, supervisors) reuses this
# same password with an email derived from SEED_DGM_EMAIL's domain.
SEED_DGM_EMAIL=dgm@example.com
SEED_DGM_PASSWORD=<choose-a-strong-password>
SEED_DGM_PHONE=<dgm-phone-number>
