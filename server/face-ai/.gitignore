# Python virtual environment & caches
.venv/
.venv*/
.venv-export/
venv/
venv*/
ENV/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Cache directories
.cache/
**/.cache/

# Test data & generated debug images
test_data/
**/test_data/
*.jpg
*.jpeg
*.png
*.webp
*.bmp

# Local env files
.env
.env.*
!.env.example
*.local

# AI Models — binary weights are NOT committed. They are downloaded at deploy/
# boot time by app/models/download.py (set MODELS_DOWNLOAD_BASE_URL). Only the
# helper scripts (*.py) and model metadata (*.json) stay tracked.
models/**/*.onnx
models/**/*.onnx.data
models/**/*.pth
models/**/*.data

# Track only the CI-required Face AI test fixtures (everything else under test_data stays ignored)
test_data/*
!test_data/
!test_data/test.jpg
!test_data/recognition/
!test_data/recognition/person1/
!test_data/recognition/person1/*.jpg
!test_data/recognition/person2/
!test_data/recognition/person2/*.jpg
!test_data/recognition/person3/
!test_data/recognition/person3/*.jpg