datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// company

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms Farm[]

  @@map("companies")
}

// Farm

model Farm {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  code   String
  name   String
  status FarmStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  sheds       Shed[]
  employees   Employee[]
  workers     Worker[]
  attendances Attendance[]

  @@unique([companyId, code])
  @@map("farms")
}

// Shed

model Shed {
  id     String @id @default(uuid()) @db.Uuid
  farmId String @db.Uuid

  number   String
  capacity Int

  status ShedStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm        Farm         @relation(fields: [farmId], references: [id])
  attendances Attendance[]

  @@unique([farmId, number])
  @@map("sheds")
}

// Designation
model Designation {
  id   String @id @default(uuid()) @db.Uuid()
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("desgination")
}

// Employee

model Employee {
  id         String @id @default(uuid()) @db.Uuid()
  employeeId String @unique

  name     String
  phone    String?
  photoUrl String?

  // 512-D ArcFace face embedding for pgvector similarity search.
  // Managed via raw SQL — Prisma cannot read/write vector columns natively.
  faceEmbedding Unsupported("vector(512)")?

  desiginationId String @db.Uuid()

  // Every employee belongs to exactly one farm; employee data is farm-scoped and
  // backend authorization filters on this column (never on the frontend).
  farmId String @db.Uuid

  joiningDate DateTime?
  status      EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designation Designation  @relation(fields: [desiginationId], references: [id])
  farm        Farm         @relation(fields: [farmId], references: [id])
  user        User?
  attendances Attendance[]

  // FK is not auto-indexed by Postgres; used as the designation join target and
  // as the designation filter in listEmployees.
  @@index([desiginationId])
  // Farm-scoped listing and authorization filter on farmId.
  @@index([farmId])
  // Phone login (findUsersByPhone) filters on phone; non-unique because several
  // employees may share a number (drives phone account selection).
  @@index([phone])
  @@map("employees")
}

// Worker
//
// A worker is a person recorded for operational purposes (attendance) who has no
// login. Workers belong to a farm and never carry User/UserRole/credentials
// unless separately provisioned as an employee later.

model Worker {
  id       String @id @default(uuid()) @db.Uuid
  workerId String @unique

  name     String
  phone    String?
  photoUrl String?

  // 512-D ArcFace face embedding for pgvector similarity search.
  // Managed via raw SQL — Prisma cannot read/write vector columns natively.
  faceEmbedding Unsupported("vector(512)")?

  farmId String @db.Uuid

  status WorkerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm        Farm         @relation(fields: [farmId], references: [id])
  attendances Attendance[]

  @@index([farmId])
  @@map("workers")
}

// User

model User {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @unique @db.Uuid

  email        String  @unique
  // Null until the account completes first-login password setup. While null,
  // password login is impossible and the session is restricted (mustSetPassword).
  passwordHash String?

  // Backend-enforced first-login state: a freshly provisioned account signs in
  // by OTP, then must set a password before it can use any business endpoint.
  mustSetPassword Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee            Employee     @relation(fields: [employeeId], references: [id])
  roles               UserRole[]
  recordedAttendances Attendance[] @relation("AttendanceRecordedBy")
  approvedAttendances Attendance[] @relation("AttendanceApprovedBy")

  @@map("users")
}

// role

model Role {
  id String @id @default(uuid()) @db.Uuid()

  name        String  @unique
  description String?

  // Scope breadth this role grants, applied relative to the user's own farm and
  // company. WHAT the role can do lives in its permissions; WHERE it can do it is
  // this level × the user's organizational position. System Admin is env-based
  // and global, so no seeded role needs GLOBAL.
  scopeLevel ScopeLevel @default(FARM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// permission

model Permission {
  id String @id @default(uuid()) @db.Uuid()

  name String @unique

  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

// user <-> role

model UserRole {
  userId String @db.Uuid()
  roleId String @db.Uuid()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

//  Role <-> Permission 

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Attendance
//
// One record per person (employee OR worker) per shift per day on a farm.
// Exactly one of employeeId / workerId is set; the paired unique indexes
// prevent a duplicate record for the same person on the same date and shift.

model Attendance {
  id String @id @default(uuid()) @db.Uuid

  // Calendar day the record is for (no time component).
  date DateTime @db.Date

  farmId String @db.Uuid

  employeeId String? @db.Uuid
  workerId   String? @db.Uuid
  shedId     String? @db.Uuid

  shift  Shift            @default(MORNING_SHIFT)
  status AttendanceStatus @default(PRESENT)

  // GPS coordinates captured at the time of marking. Required — the UI blocks
  // attendance creation when the browser denies location access.
  latitude  Float
  longitude Float

  notes String?

  // Face-AI verification fields (populated when attendance is marked via face recognition).
  verificationMode String?  @default("MANUAL") // "MANUAL" | "FACE_AI"
  livenessScore    Float?
  qualityScore     Float?
  confidenceScore  Float?
  snapshotUrl      String?  // Cloudinary URL of the attendance snapshot image

  // Correction/approval lifecycle. recordedBy is who entered it; approvedBy and
  // approvedAt are set when a manager/DGM finalizes it. Both are nullable because
  // the global System Admin has no User row to reference.
  recordedById String?   @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm       Farm      @relation(fields: [farmId], references: [id])
  shed       Shed?     @relation(fields: [shedId], references: [id])
  employee   Employee? @relation(fields: [employeeId], references: [id])
  worker     Worker?   @relation(fields: [workerId], references: [id])
  recordedBy User?     @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  approvedBy User?     @relation("AttendanceApprovedBy", fields: [approvedById], references: [id])

  // One record per person per shift per day.
  @@unique([date, shift, employeeId])
  @@unique([date, shift, workerId])
  @@index([farmId, date])
  // Dashboard query: attendance marked by a specific user on a date.
  @@index([recordedById, date])
  @@map("attendances")
}

// ENUMS

enum ScopeLevel {
  FARM
  COMPANY
  GLOBAL
}

enum FarmStatus {
  ACTIVE
  INACTIVE
}

enum ShedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum Shift {
  MORNING_SHIFT
  AFTERNOON_SHIFT
  NIGHT_SHIFT
  OVERTIME
}

// Otp

model OtpChallenge {
  id String @id @default(uuid()) @db.Uuid

  phone String

  otpHash String

  expiresAt DateTime

  attempts Int @default(0)

  consumedAt DateTime?

  createdAt DateTime @default(now())

  // Active-challenge lookup filters phone and orders by createdAt desc; the
  // composite serves both equality and ordering, so a plain [phone] is redundant.
  @@index([phone, createdAt])
  @@map("otp_challenges")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  action      AuditAction
  entity      String
  entityId    String?
  summary     String
  changes     Json?
  actorId     String?     @db.Uuid
  actorName   String
  actorEmail  String?
  actorRoles  Json?
  companyName String?
  farmName    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([actorId])
  @@map("audit_logs")
}
